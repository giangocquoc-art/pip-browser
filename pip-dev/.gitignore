packages/browseros/.data/windows-sdk-26100-validation/
packages/browseros/.data/windows-sdk-nuget-stage/
packages/browseros-agent/.data/verify-npm-cache/

# BrowserOS's internal-docs submodule is private; Pip Dev builds do not use it.
.internal-docs/
.gitmodules
.github/workflows/sync-internal-docs.yml
.claude/skills/ask-internal/
.claude/skills/write-internal-docs/

